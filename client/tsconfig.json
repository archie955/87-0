{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },

    "jsx": "react-jsx",

    "allowJs": false,
    "checkJs": false,

    "strict": true,

    "isolatedModules": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,

    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "./src",
    "outDir": "./build",
    "types": ["jest", "@testing-library/jest-dom", "vitest/globals"]
  },
  "include": ["src", "vite-env.d.ts"],
  "exclude": ["src/template"]
}
